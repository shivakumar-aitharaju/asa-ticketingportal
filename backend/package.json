{
  "name": "raiseaticket-backend",
  "version": "1.0.0",
  "description": "ASA RaiseATicket Portal — Fastify backend",
  "main": "app.ts",
  "scripts": {
    "start": "npm run build && fastify start -l info dist/app.js",
    "start:prod": "node dist/scripts/seed.js && node dist/server.js",
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch\" \"npm:dev:start\"",
    "dev:start": "fastify start --ignore-watch=\".ts$\" -w -l info -P dist/app.js",
    "migration:generate": "ts-node -r dotenv/config ./node_modules/typeorm/cli.js migration:generate -d src/configs/data-source.ts",
    "migration:run": "ts-node -r dotenv/config ./node_modules/typeorm/cli.js migration:run -d src/configs/data-source.ts",
    "migration:revert": "ts-node -r dotenv/config ./node_modules/typeorm/cli.js migration:revert -d src/configs/data-source.ts",
    "migration:show": "ts-node -r dotenv/config ./node_modules/typeorm/cli.js migration:show -d src/configs/data-source.ts",
    "seed": "ts-node -r dotenv/config src/scripts/seed.ts",
    "sample-data": "ts-node -r dotenv/config src/scripts/sample-data.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@azure/identity": "^4.13.0",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.2",
    "date-fns": "^4.1.0",
    "fastify": "^5.8.1",
    "fastify-cli": "^7.4.1",
    "fastify-mailer": "^2.3.1",
    "fastify-plugin": "^5.1.0",
    "fastify-socket.io": "^5.1.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.9.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.20",
    "uuid": "^13.0.0",
    "zod": "^4.1.13",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.10.1",
    "@vercel/node": "^5.1.15",
    "@types/pg": "^8.15.6",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "fastify-tsconfig": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "fastify-socket.io",
      "msgpackr-extract",
      "protobufjs"
    ]
  }
}
